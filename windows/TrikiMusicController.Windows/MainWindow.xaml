<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TrikiMusicController_Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Triki Music Controller"
    mc:Ignorable="d">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <TitleBar x:Name="AppTitleBar" Title="Triki Music Controller">
                <TitleBar.IconSource><ImageIconSource ImageSource="Assets/AppIcon.ico" /></TitleBar.IconSource>
            </TitleBar>
            <Button
                x:Name="InfoButton"
                Width="40"
                Height="40"
                Margin="0,0,146,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                Click="Info_Click"
                AutomationProperties.Name="Informacje"
                ToolTipService.ToolTip="Informacje">
                <FontIcon Glyph="&#xE946;" FontSize="16" />
            </Button>
        </Grid>
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="760"
            ExpandedModeThresholdWidth="1080"
            OpenPaneLength="224"
            PaneTitle="Triki Music"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Start" Tag="home">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Sterowanie" Tag="controls">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Urządzenie" Tag="device">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE702;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
