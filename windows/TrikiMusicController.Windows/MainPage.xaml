<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrikiMusicController_Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="1180" Padding="28" Spacing="18" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Triki Music Controller" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Połączenie, muzyka i gesty w jednym miejscu" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Grid x:Name="DashboardGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DashboardSecondaryColumn" Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Narrow">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="DashboardSecondaryColumn.Width" Value="0" />
                                <Setter Target="MediaCard.(Grid.Column)" Value="0" />
                                <Setter Target="MediaCard.(Grid.Row)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="DashboardSecondaryColumn.Width" Value="*" />
                                <Setter Target="MediaCard.(Grid.Column)" Value="1" />
                                <Setter Target="MediaCard.(Grid.Row)" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding ConnectionTitle}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding ConnectionDetails}" TextWrapping="Wrap" Opacity="0.78" />
                        <TextBlock Text="{Binding ConnectionModeSummary}" Style="{StaticResource PageSubtitleStyle}" />
                        <Button Click="Scan_Click" AutomationProperties.Name="Skanuj urządzenia Triki">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Find" />
                                <TextBlock Text="Skanuj urządzenia" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border x:Name="MediaCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Teraz odtwarzane" Opacity="0.72" />
                        <TextBlock Text="{Binding MediaTitle}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding MediaDetails}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PlaybackStatus}" Opacity="0.75" />
                        <CommandBar DefaultLabelPosition="Right" Background="Transparent">
                            <AppBarButton Label="Poprzedni" Icon="Previous" Click="Previous_Click" />
                            <AppBarButton Label="Odtwórz / pauza" Icon="Play" Click="PlayPause_Click" />
                            <AppBarButton Label="Następny" Icon="Next" Click="Next_Click" />
                        </CommandBar>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ControlSecondaryColumn" Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="ControlsNarrow">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="ControlSecondaryColumn.Width" Value="0" />
                                <Setter Target="GestureCard.(Grid.Column)" Value="0" />
                                <Setter Target="GestureCard.(Grid.Row)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="ControlsWide">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="ControlSecondaryColumn.Width" Value="*" />
                                <Setter Target="GestureCard.(Grid.Column)" Value="1" />
                                <Setter Target="GestureCard.(Grid.Row)" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding VolumeControlTitle}" Style="{StaticResource SectionTitleStyle}" />
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding VolumeProgress}" />
                        <TextBlock Text="{Binding VolumeControlDetails}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding VolumeText}" Opacity="0.75" />
                    </StackPanel>
                </Border>
                <Border x:Name="GestureCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Like / Dislike" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding GestureStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LastActionStatus}" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
