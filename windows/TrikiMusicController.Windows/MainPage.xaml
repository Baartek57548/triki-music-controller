<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrikiMusicController_Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid MaxWidth="1180" Padding="32,24,32,32" RowSpacing="20" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Start" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Najważniejsze informacje i sterowanie muzyką" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="18" RowSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition x:Name="HomeSecondaryColumn" Width="1.1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="HomeNarrow">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="HomeSecondaryColumn.Width" Value="0" />
                                <Setter Target="NowPlayingCard.(Grid.Column)" Value="0" />
                                <Setter Target="NowPlayingCard.(Grid.Row)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="HomeWide">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="HomeSecondaryColumn.Width" Value="1.1*" />
                                <Setter Target="NowPlayingCard.(Grid.Column)" Value="1" />
                                <Setter Target="NowPlayingCard.(Grid.Row)" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="21" Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE702;" FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Triki" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding ConnectionTitle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ConnectionDetails}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding BatteryText}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Bateria" Style="{StaticResource MetadataTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding SignalQuality}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Sygnał" Style="{StaticResource MetadataTextStyle}" />
                            </StackPanel>
                        </Grid>
                        <Button Content="Zarządzaj urządzeniem" Click="Device_Click" HorizontalAlignment="Left" AutomationProperties.Name="Otwórz ekran urządzenia Triki" />
                    </StackPanel>
                </Border>

                <Border x:Name="NowPlayingCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="96" Height="96" CornerRadius="12" Background="{ThemeResource AccentFillColorTertiaryBrush}" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE8D6;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Teraz odtwarzane" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding MediaTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding MediaDetails}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PlaybackStatus}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Width="44" Height="44" Background="Transparent" Click="Previous_Click" ToolTipService.ToolTip="Poprzedni utwór" AutomationProperties.Name="Poprzedni utwór">
                                    <SymbolIcon Symbol="Previous" />
                                </Button>
                                <Button Width="56" Height="44" Style="{StaticResource AccentButtonStyle}" Click="PlayPause_Click" ToolTipService.ToolTip="{Binding PlayPauseLabel}" AutomationProperties.Name="{Binding PlayPauseLabel}">
                                    <FontIcon Glyph="{Binding PlayPauseGlyph}" />
                                </Button>
                                <Button Width="44" Height="44" Background="Transparent" Click="Next_Click" ToolTipService.ToolTip="Następny utwór" AutomationProperties.Name="Następny utwór">
                                    <SymbolIcon Symbol="Next" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding VolumeText}" Style="{StaticResource MetadataTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Sterowanie Triki" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding ControllerStatusTitle}" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding LastActionCompact}" Style="{StaticResource MetadataTextStyle}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding ControllerStatusDetails}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ControllerProgress}" AutomationProperties.Name="Postęp przygotowania sterowania Triki" />
                    <Grid ColumnSpacing="18" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Obrót → głośność" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontWeight="SemiBold">
                            <Run Text="Odwróć + " />
                            <Run Text="{Binding RotationAngleLabel}" />
                            <Run Text=" → utwór" />
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="Przycisk → Play/Pause" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
