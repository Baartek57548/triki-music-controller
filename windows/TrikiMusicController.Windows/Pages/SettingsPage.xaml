<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrikiMusicController_Windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="850" Padding="28" Spacing="18" HorizontalAlignment="Stretch">
            <TextBlock Text="Ustawienia" Style="{StaticResource PageTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Połączenie" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding RememberedDevice}" TextWrapping="Wrap" />
                    <ToggleSwitch Header="Automatycznie łącz po wybudzeniu Triki" IsOn="{Binding AutoReconnect, Mode=TwoWay}" />
                    <ToggleSwitch Header="Uruchamiaj aplikację razem z Windows" IsOn="{Binding StartWithWindows, Mode=TwoWay}" />
                    <ComboBox Header="Motyw aplikacji"
                              ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                              HorizontalAlignment="Left"
                              MinWidth="220" />
                    <TextBlock Text="Autostart pozwala wykryć krótką reklamę BLE wysłaną po naciśnięciu przycisku, również gdy okno jest zminimalizowane." TextWrapping="Wrap" Opacity="0.72" />
                    <TextBlock Text="{Binding SettingsStatus}" TextWrapping="Wrap" Opacity="0.72" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Prywatność" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Aplikacja nie wysyła danych czujników do chmury. Sieć jest używana wyłącznie do sprawdzania publicznych wydań GitHub." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
