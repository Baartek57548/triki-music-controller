<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrikiMusicController_Windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="880" Padding="32,24,32,32" Spacing="24" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Ustawienia" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Preferencje połączenia, zachowanie aplikacji i narzędzia" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- 1. Połączenie i zasilanie -->
            <StackPanel Spacing="10">
                <TextBlock Text="Połączenie i zasilanie" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16">
                        <ToggleSwitch Header="Automatyczne łączenie"
                                      OffContent="Wyłączone"
                                      OnContent="Włączone"
                                      IsOn="{Binding AutoReconnect, Mode=TwoWay}"
                                      AutomationProperties.HelpText="Łącz z kontrolerem natychmiast po jego wybudzeniu." />

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <ComboBox Header="Tryb połączenia" ItemsSource="{Binding AvailablePowerModes}"
                                  SelectedItem="{Binding SelectedPowerMode, Mode=TwoWay}" DisplayMemberPath="DisplayName"
                                  HorizontalAlignment="Stretch" AutomationProperties.HelpText="Czas bez ruchu i przycisku. Domyślnie Normal: 30 minut." />
                        <TextBlock Text="{Binding ConnectionModeSummary}"
                                   Style="{StaticResource MetadataTextStyle}" />

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <ComboBox Header="Priorytet wielu urządzeń"
                                  ItemsSource="{Binding AvailableArbitrationModes}"
                                  SelectedItem="{Binding SelectedArbitrationMode, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  HorizontalAlignment="Left"
                                  MinWidth="320" />
                        <TextBlock Text="Priorytet aktywnej muzyki natychmiast łączy urządzenie z grającym odtwarzaczem i ustępuje drugiemu urządzeniu w stanie spoczynku."
                                   Style="{StaticResource MetadataTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Czułość gestów" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="100% oznacza dotychczasową czułość. Większa wartość daje silniejszą reakcję na ten sam ruch."
                                   Style="{StaticResource MetadataTextStyle}" />
                        <ToggleSwitch Header="Gest głośności" IsOn="{Binding VolumeGestureEnabled, Mode=TwoWay}" />
                        <TextBlock Text="{Binding VolumeSensitivityLabel}" />
                        <Slider Minimum="50" Maximum="200" StepFrequency="10" SnapsTo="StepValues"
                                Value="{Binding VolumeSensitivityPercent, Mode=TwoWay}" IsEnabled="{Binding VolumeGestureEnabled}"
                                AutomationProperties.Name="Czułość gestu głośności w procentach" />
                        <ToggleSwitch Header="Gest jasności" IsOn="{Binding BrightnessGestureEnabled, Mode=TwoWay}" />
                        <TextBlock Text="{Binding BrightnessSensitivityLabel}" />
                        <Slider Minimum="50" Maximum="200" StepFrequency="10" SnapsTo="StepValues"
                                Value="{Binding BrightnessSensitivityPercent, Mode=TwoWay}" IsEnabled="{Binding BrightnessGestureEnabled}"
                                AutomationProperties.Name="Czułość gestu jasności w procentach" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Expander Header="Historia połączeń" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding ConnectionHistoryStatus}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Eksportuj JSON" Click="ExportHistory_Click" />
                        <Button Content="Wyczyść historię" Click="ClearHistory_Click" />
                    </StackPanel>
                    <ListView ItemsSource="{Binding ConnectionHistory}" MaxHeight="320" SelectionMode="None"
                              AutomationProperties.Name="Zdarzenia połączeń od najnowszego">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4" Padding="0,6">
                                    <TextBlock Text="{Binding TimeDisplay}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Expander>
            <TextBlock Text="{Binding SettingsStatus}" TextWrapping="Wrap" Style="{StaticResource MetadataTextStyle}" />

            <!-- 2. Działanie aplikacji -->
            <StackPanel Spacing="10">
                <TextBlock Text="Działanie aplikacji" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16">
                        <ToggleSwitch Header="Uruchamiaj z systemem Windows"
                                      OffContent="Wyłączone"
                                      OnContent="Włączone"
                                      IsOn="{Binding StartWithWindows, Mode=TwoWay}"
                                      AutomationProperties.HelpText="Start w tle w zasobniku systemowym bez otwierania okna." />

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <ToggleSwitch Header="Dźwięki potwierdzenia akcji"
                                      OffContent="Wyłączone"
                                      OnContent="Włączone"
                                      IsOn="{Binding EnableSoundFeedback, Mode=TwoWay}"
                                      AutomationProperties.HelpText="Krótki sygnał audio w głośnikach po naciśnięciu przycisku lub geście." />

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <ToggleSwitch Header="Powiadomienia systemowe"
                                      OffContent="Wyłączone"
                                      OnContent="Włączone"
                                      IsOn="{Binding EnableToastNotifications, Mode=TwoWay}"
                                      AutomationProperties.HelpText="Powiadomienia dymkowe Windows o stanie połączenia." />

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <ComboBox Header="Motyw aplikacji"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  HorizontalAlignment="Left"
                                  MinWidth="260" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. Integracje -->
            <StackPanel Spacing="10">
                <TextBlock Text="Integracje" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Spotify Connect" FontWeight="SemiBold" />
                        <TextBlock Text="Zdalne sterowanie odtwarzaniem i głośnością na zewnętrznych urządzeniach Spotify (głośniki Sonos, TV, konsole) w domowej sieci WiFi."
                                   Style="{StaticResource MetadataTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 4. O aplikacji i aktualizacje -->
            <StackPanel Spacing="10">
                <TextBlock Text="O aplikacji i aktualizacje" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Triki Music Controller" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AppVersionDisplay}" Style="{StaticResource MetadataTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="CheckUpdates_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    <TextBlock Text="Sprawdź aktualizacje" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="Permissions_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72E;" FontSize="14" />
                                    <TextBlock Text="Uprawnienia systemowe" />
                                </StackPanel>
                            </Button>
                            <Button Click="About_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" />
                                    <TextBlock Text="Informacje i repozytorium" />
                                </StackPanel>
                            </Button>
                            <Button Click="Diagnostics_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                    <TextBlock Text="Diagnostyka IMU" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
