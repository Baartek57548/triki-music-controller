<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrikiMusicController_Windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="880" Padding="32,24,32,32" Spacing="20" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Ustawienia" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Połączenie, zachowanie aplikacji i funkcje zaawansowane" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Triki" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{Binding RememberedDevice}" Style="{StaticResource MetadataTextStyle}" />
            </StackPanel>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <ToggleSwitch Header="Automatycznie łącz po wybudzeniu"
                                  OffContent="Wyłączone"
                                  OnContent="Włączone"
                                  IsOn="{Binding AutoReconnect, Mode=TwoWay}"
                                  AutomationProperties.HelpText="Łączy zapamiętany kontroler po naciśnięciu jego przycisku." />
                    <ToggleSwitch Header="Łącz tylko podczas użycia"
                                  OffContent="Stała gotowość"
                                  OnContent="Na żądanie"
                                  IsOn="{Binding ConnectOnlyWhenNeeded, Mode=TwoWay}"
                                  AutomationProperties.HelpText="Zamyka aktywne połączenie po 12 sekundach bezczynności." />
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Tryb połączenia" Message="{Binding ConnectionModeSummary}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Aplikacja" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <ToggleSwitch Header="Uruchamiaj w tle razem z Windows"
                                  OffContent="Wyłączone"
                                  OnContent="Włączone"
                                  IsOn="{Binding StartWithWindows, Mode=TwoWay}"
                                  AutomationProperties.HelpText="Uruchamia Triki bez otwierania okna i pozostawia aplikację w zasobniku systemowym." />
                    <TextBlock Text="Triki zawsze rozpoczyna pracę po cichu w obszarze powiadomień. Minimalizacja i przycisk X ukrywają okno bez wyłączania sterowania. Dwukrotnie kliknij ikonę Triki, aby ponownie otworzyć okno."
                               Style="{StaticResource MetadataTextStyle}" />
                    <ComboBox Header="Motyw"
                              ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                              HorizontalAlignment="Left"
                              MinWidth="240" />
                </StackPanel>
            </Border>

            <TextBlock Text="Gest obrotu" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="Wymagany obrót: " />
                            <Run Text="{Binding RotationAngleLabel}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </TextBlock>
                        <TextBlock Text="Ustaw, o ile stopni trzeba obrócić odwrócony kapsel, aby zmienić utwór. Mniejszy kąt = łatwiejsze wyzwolenie, większy = mniej przypadkowych zmian."
                                   Style="{StaticResource MetadataTextStyle}" />
                    </StackPanel>
                    <Slider
                        Minimum="90"
                        Maximum="360"
                        StepFrequency="5"
                        TickFrequency="45"
                        TickPlacement="Outside"
                        Value="{Binding RotationAngleDegrees, Mode=TwoWay}"
                        AutomationProperties.Name="Wymagany kąt obrotu do zmiany utworu"
                        HorizontalAlignment="Stretch" />
                    <Grid ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="90°" HorizontalAlignment="Left" Style="{StaticResource MetadataTextStyle}" />
                        <TextBlock Grid.Column="1" Text="225°" HorizontalAlignment="Center" Style="{StaticResource MetadataTextStyle}" />
                        <TextBlock Grid.Column="2" Text="360°" HorizontalAlignment="Right" Style="{StaticResource MetadataTextStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Zaawansowane" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Diagnostyka" FontWeight="SemiBold" />
                    <TextBlock Text="Dane IMU, częstotliwość próbek i szczegóły protokołu są oddzielone od codziennego sterowania." Style="{StaticResource PageSubtitleStyle}" />
                    <Button Content="Otwórz diagnostykę" Click="Diagnostics_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <TextBlock Text="Informacje" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Wersja, aktualizacje i prywatność" FontWeight="SemiBold" />
                    <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                        <AppBarButton Icon="Help" Label="O aplikacji" Click="About_Click" />
                        <AppBarButton Icon="Sync" Label="Sprawdź aktualizacje" Click="CheckUpdates_Click" />
                    </CommandBar>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding SettingsStatus}" TextWrapping="Wrap" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
