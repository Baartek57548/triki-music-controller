<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrikiMusicController_Windows.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="880" Padding="32,24,32,32" Spacing="20" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Informacje" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Zappki • najważniejsze zasady obsługi, prywatność i wersja aplikacji." Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource AccentFillColorTertiaryBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE702;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Połączenie Bluetooth LE" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Przy pierwszym użyciu wybudź Triki przyciskiem, wyszukaj je w zakładce Urządzenie i połącz. Komputer zapamięta kapsel — kolejne naciśnięcie przycisku wybudzi urządzenie i uruchomi automatyczne łączenie." TextWrapping="Wrap" />
                        <TextBlock Text="Opcja „Łącz tylko podczas użycia” oszczędza baterię: po bezczynności zamyka aktywne połączenie, a lekki nasłuch BLE wznawia je po wybudzeniu kapsla." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource AccentFillColorTertiaryBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Regulacja głośności" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Utrzymuj przechył kapsla w zakresie 0–25° przez 2 sekundy. Kapsel nie musi leżeć nieruchomo, ale gwałtowne przyspieszenie poza 0,80–1,20 g wstrzymuje regulację i rozpoczyna stabilizację od nowa. Po aktywacji wygładzona wartość żyroskopu osi Z łagodnie reguluje głośność systemową." TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource AccentFillColorTertiaryBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7AD;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="Sterowanie utworem i oceny" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Dwa kliknięcia przycisku lubią utwór, a trzy kliknięcia go odrzucają; każda rozpoznana ocena ma własny krótki sygnał dźwiękowy. Aby zmienić utwór bez przycisku, odwróć kapsel i odczekaj około pół sekundy. Następnie obróć go o ustawiony kąt (domyślnie 200°): w lewo przejdziesz do następnego utworu, a w prawo wrócisz do poprzedniego." TextWrapping="Wrap" />
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Oceny utworów" Message="Windows nie udostępnia systemowej komendy Like/Dislike. Kliknięcia zostaną rozpoznane, ale zastosowanie oceny zależy od aktywnego odtwarzacza." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Zappki — Triki Music Controller dla Windows 11" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Wersja 2.8.0 • Windows x64" Style="{StaticResource MetadataTextStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource AccentPillBorderStyle}" VerticalAlignment="Center">
                            <TextBlock Text="v2.8.0" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>

                    <TextBlock Text="Natywna aplikacja WinUI 3 sterująca globalną sesją multimedialną i głośnością domyślnego urządzenia audio." TextWrapping="Wrap" />
                    <TextBlock Text="Dane czujników pozostają lokalnie na komputerze. Sieć jest używana wyłącznie do sprawdzania publicznych wydań GitHub; aplikacja sprawdza nową wersję po uruchomieniu." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="CheckUpdates_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                <TextBlock Text="Sprawdź aktualizacje" />
                            </StackPanel>
                        </Button>
                        <Button Click="GitHub_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71B;" FontSize="14" />
                                <TextBlock Text="Projekt na GitHub" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
