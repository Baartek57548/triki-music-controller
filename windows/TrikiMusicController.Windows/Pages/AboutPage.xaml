<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrikiMusicController_Windows.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="850" Padding="28" Spacing="18" HorizontalAlignment="Stretch">
            <TextBlock Text="Informacje" Style="{StaticResource PageTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Połączenie" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Przy pierwszym użyciu wybudź Triki przyciskiem, wyszukaj je i połącz. Komputer zapamięta kapsel; kolejne naciśnięcie przycisku wybudzi urządzenie i uruchomi automatyczne łączenie." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Głośność" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Utrzymuj przechył kapsla w zakresie 0–25° przez 2 sekundy. Stabilizacja dotyczy położenia w tym zakresie, nie bezruchu. Po aktywacji wygładzona wartość żyroskopu osi Z płynnie reguluje głośność systemową." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Like i Dislike" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Przytrzymaj przycisk około pół sekundy. Podnieś kapsel o 20–30 cm, aby polubić utwór, albo opuść go o 20–30 cm, aby wysłać Dislike. Osobne krótkie sygnały dźwiękowe potwierdzają obie akcje." TextWrapping="Wrap" />
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Ograniczenie Windows" Message="Systemowe Media Control nie udostępnia standardowej akcji Like/Dislike. Gest jest rozpoznawany, ale wymaga odtwarzacza z osobną integracją oceniania." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Prywatność i aktualizacje" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Dane czujników pozostają lokalnie na komputerze. Sieć jest używana wyłącznie do sprawdzania publicznych wydań GitHub. Aplikacja sprawdza nową wersję po uruchomieniu." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Triki Music Controller dla Windows 11" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Wersja 2.3.1 • Windows x64" />
                    <TextBlock Text="Natywna aplikacja WinUI 3 sterująca globalną sesją multimedialną i głośnością domyślnego urządzenia audio." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Sprawdź aktualizacje" Click="CheckUpdates_Click" />
                        <Button Content="Otwórz projekt na GitHub" Click="GitHub_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
