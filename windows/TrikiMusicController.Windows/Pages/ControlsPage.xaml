<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrikiMusicController_Windows.Pages.ControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="900" Padding="28" Spacing="18" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Sterowanie" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Regulacja głośności i mapowanie fizycznego przycisku" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Płynna regulacja głośności" Style="{StaticResource SectionTitleStyle}" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding VolumeProgress}" />
                    <TextBlock Text="{Binding VolumeControlTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VolumeControlDetails}" TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Nawigacja pełnym obrotem" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Odwróć kapsel, ustabilizuj go przez 0,5 s i wykonaj jeden pełny obrót wokół osi Z. Obrót w prawo przechodzi do następnego utworu, a w lewo wraca do poprzedniego — bez wciskania przycisku." TextWrapping="Wrap" Opacity="0.75" />
                    <TextBlock Text="Dwa kliknięcia przycisku → Like • trzy kliknięcia → Dislike" TextWrapping="Wrap" Opacity="0.75" />
                    <TextBlock Text="{Binding GestureStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Akcje przycisku" Style="{StaticResource SectionTitleStyle}" />
                    <ComboBox Header="Jeden klik" ItemsSource="{Binding AvailableActions}" SelectedItem="{Binding SingleClickAction, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <ComboBox Header="Dwa kliknięcia" ItemsSource="{Binding AvailableActions}" SelectedItem="{Binding DoubleClickAction, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <ComboBox Header="Trzy kliknięcia" ItemsSource="{Binding AvailableActions}" SelectedItem="{Binding TripleClickAction, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
