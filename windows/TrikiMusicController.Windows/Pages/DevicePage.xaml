<Page
    x:Class="TrikiMusicController_Windows.Pages.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1040" Padding="32,24,32,32" RowSpacing="20" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Nagłówek -->
            <StackPanel Spacing="4">
                <TextBlock Text="Urządzenie Triki" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Połącz kapsel raz, a Windows zapamięta go i automatycznie wznowi połączenie po wybudzeniu przyciskiem." Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Karta Stanu Połączenia i Akcji -->
            <Border Grid.Row="1" Style="{StaticResource HeroCardBorderStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource AccentFillColorTertiaryBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE702;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="STAN POŁĄCZENIA BLUETOOTH LE" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding ConnectionTitle}" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource AccentPillBorderStyle}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConnectionStateBadge}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding ConnectionDetails}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Kafelki Telemetrii: Bateria i Sygnał -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource TileBorderStyle}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEBB5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="BATERIA" Style="{StaticResource EyebrowTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding BatteryText}" Style="{StaticResource StatNumberStyle}" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding BatteryFraction}" Height="5" CornerRadius="3"
                                             Foreground="{StaticResource BrandAccentBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource TileBorderStyle}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE704;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="JAKOŚĆ SYGNAŁU" Style="{StaticResource EyebrowTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SignalQuality}" Style="{StaticResource StatNumberStyle}" />
                                <TextBlock Text="Wskaźnik mocy sygnału RSSI" Style="{StaticResource MetadataTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bezpośrednie przyciski sterowania urządzeniem -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Scan_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsActive="{Binding IsScanning}" />
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock Text="Znajdź Triki" />
                            </StackPanel>
                        </Button>
                        <Button Click="Connect_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="Połącz" />
                            </StackPanel>
                        </Button>
                        <Button Click="Disconnect_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                <TextBlock Text="Rozłącz" />
                            </StackPanel>
                        </Button>
                        <Button Click="Forget_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Zapomnij" />
                            </StackPanel>
                        </Button>
                        <ToggleButton Click="Led_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA80;" FontSize="14" />
                                <TextBlock Text="Dioda LED" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Karta Wykrytych Urządzeń -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="WYKRYTE KONTROLERY TRIKI" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="Lista urządzeń w pobliżu" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource PillBorderStyle}" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MetadataTextStyle}">
                                <Run Text="Znaleziono: " /><Run Text="{Binding Devices.Count}" />
                            </TextBlock>
                        </Border>
                    </Grid>

                    <ListView
                        MinHeight="120"
                        MaxHeight="260"
                        ItemsSource="{Binding Devices}"
                        SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                        SelectionMode="Single"
                        AutomationProperties.Name="Wykryte urządzenia Bluetooth LE">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="14" Padding="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE702;" FontSize="16" Foreground="{StaticResource BrandAccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding AddressDisplay}" Style="{StaticResource MetadataTextStyle}" FontFamily="Consolas" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource PillBorderStyle}" VerticalAlignment="Center">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding Rssi}" /><Run Text=" dBm" />
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="💡 Jeżeli lista jest pusta, naciśnij fizyczny przycisk na kapslu Triki, a następnie kliknij przycisk „Znajdź Triki”."
                               Style="{StaticResource MetadataTextStyle}" />
                </StackPanel>
            </Border>

            <!-- Informacja pomocnicza -->
            <InfoBar
                Grid.Row="3"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Zapamiętane urządzenie i automatyczne wznawianie"
                Message="{Binding ConnectionModeSummary}" />
        </Grid>
    </ScrollViewer>
</Page>
