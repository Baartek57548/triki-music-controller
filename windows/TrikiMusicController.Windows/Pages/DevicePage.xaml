<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrikiMusicController_Windows.Pages.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid MaxWidth="1000" Padding="28" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Urządzenie Triki" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Połącz kapsel raz, a Windows zapamięta go i wznowi połączenie po wybudzeniu przyciskiem." Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <InfoBar
                Grid.Row="1"
                Margin="0,18,0,14"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="{Binding ConnectionTitle}"
                Message="{Binding ConnectionDetails}" />

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource TileBorderStyle}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEBB5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="POZIOM BATERII" Style="{StaticResource EyebrowTextStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding BatteryText}" Style="{StaticResource StatNumberStyle}" />
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding BatteryFraction}" Height="4" CornerRadius="2"
                                         Foreground="{StaticResource BrandAccentBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource TileBorderStyle}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE704;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="JAKOŚĆ SYGNAŁU" Style="{StaticResource EyebrowTextStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SignalQuality}" Style="{StaticResource StatNumberStyle}" />
                            <TextBlock Text="Wskaźnik RSSI Bluetooth LE" Style="{StaticResource MetadataTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" Margin="0,22,0,8" Text="Wykryte urządzenia" Style="{StaticResource SectionTitleStyle}" />

            <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="8">
                <ListView
                    MinHeight="160"
                    ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                    SelectionMode="Single"
                    AutomationProperties.Name="Wykryte urządzenia Bluetooth LE"
                    AutomationProperties.HelpText="Jeżeli lista jest pusta, wybudź kapsel przyciskiem i wybierz Znajdź Triki.">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="8,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE702;" FontSize="16" Foreground="{StaticResource BrandAccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Urządzenie Żabka Triki" Style="{StaticResource MetadataTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <CommandBar Grid.Row="5" Margin="0,12,0,0" DefaultLabelPosition="Right" Background="Transparent">
                <AppBarButton Icon="Find" Label="Znajdź Triki" Click="Scan_Click" />
                <AppBarButton Icon="Accept" Label="Połącz" Click="Connect_Click" />
                <AppBarButton Icon="Cancel" Label="Rozłącz" Click="Disconnect_Click" />
                <AppBarButton Icon="Delete" Label="Zapomnij" Click="Forget_Click" />
                <AppBarSeparator />
                <AppBarToggleButton Icon="Highlight" Label="Dioda LED" Click="Led_Click" />
            </CommandBar>
        </Grid>
    </Grid>
</Page>
